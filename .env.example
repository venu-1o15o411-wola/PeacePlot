# PeacePlot — environment variables
# Copy this file to `.env` and fill in values from your Supabase project:
#   Dashboard → Project Settings → API
#
# Expo inlines only variables prefixed with EXPO_PUBLIC_ into the client bundle.
# Never put the service_role key or other secrets in EXPO_PUBLIC_* variables.

# -----------------------------------------------------------------------------
# Supabase — required for the app client (Auth, Postgres, Storage, Realtime)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------------
# Supabase — public labels (optional; defaults can live in code instead)
# Use if you want bucket names configurable without code changes.
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET_AVATARS=avatars
# EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET_MEDIA=media

# -----------------------------------------------------------------------------
# Server-side / CI only — NOT for the Expo app bundle
# Use in Supabase Edge Functions, GitHub Actions, or local scripts — never commit real values.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_PROJECT_REF=your-project-ref
