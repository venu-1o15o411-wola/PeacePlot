{
  "expo": {
    "name": "PeacePlot",
    "slug": "PeacePlot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app/icon.png",
    "scheme": "peaceplot",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.PeacePlot"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app/android-icon-foreground.png",
        "backgroundImage": "./assets/images/app/android-icon-background.png",
        "monochromeImage": "./assets/images/app/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/app/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "PeacePlot uses the microphone only to record short voice samples for stress check-ins—not for music or background listening."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PeacePlot uses the camera for a one-time face check-in to estimate stress. Photos are processed on your device when face detection is available."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "PeacePlot uses the back camera and flash to measure a short finger pulse signal for stress check-ins.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": true
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
